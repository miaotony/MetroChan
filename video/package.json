{
  "name": "video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.547",
    "@remotion/media": "4.0.547",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.547"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.547",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "prepare:data": "bun scripts/prepare-data.ts",
    "dev": "bun run prepare:data && remotionb studio",
    "build": "bun run prepare:data && remotionb bundle --out-dir=out/bundle",
    "render": "bun run prepare:data && remotionb render MetroChanIntro out/MetroChanIntro.mp4 --crf=17 --audio-bitrate=256k",
    "stills": "bun scripts/stills.ts",
    "og": "bun scripts/og.ts",
    "music": "bun scripts/make_music.ts",
    "capture": "bun scripts/capture.ts",
    "qr": "bun scripts/build_qr.ts",
    "upgrade": "remotionb upgrade",
    "typecheck": "bun run prepare:data && tsc --noEmit",
    "lint": "eslint src && bun run typecheck"
  }
}
